{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixelmon - Pokelist",
  "version": "1.0.9",
  "identifier": "com.gabrielmwalker.pixelmon-pokedex-checklist",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pixelmon - Pokelist",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.pokemondb.net; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "icons/icon.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QjBBMTgyRjA2Njc4RDAKUldUUWVHYndncUd3aVdETndHMGM4RVhIdnl4Z3Bkak5PRTVHMXFpTG15S0Z5ZHlCZzJQdjZkUVgK",
      "endpoints": [
        "https://github.com/GabrielMWalker/CustomPokeDex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
